  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"display_name\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"last_active_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "wallets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallets\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"balance\" INTEGER NOT NULL CHECK(\"balance\" >= 0), PRIMARY KEY (\"profile_id\"));"
        }
      ]
    },
    {
      "name": "ledger_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger_entries\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "mood_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mood_entries\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"mood\" TEXT NOT NULL, \"weight_delta\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "emotional_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"emotional_states\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"weight\" INTEGER NOT NULL DEFAULT 0, \"consecutive_negative\" INTEGER NOT NULL DEFAULT 0, \"last_intervention_at\" TEXT NULL, PRIMARY KEY (\"profile_id\"));"
        }
      ]
    },
    {
      "name": "owned_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"owned_items\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"item_id\" TEXT NOT NULL, \"acquired_at\" TEXT NOT NULL, PRIMARY KEY (\"profile_id\", \"item_id\"));"
        }
      ]
    },
    {
      "name": "selections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"selections\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"slot\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, PRIMARY KEY (\"profile_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "conversation_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"conversation_progress\" (\"profile_id\" INTEGER NOT NULL REFERENCES profiles (id) ON DELETE CASCADE, \"tree_id\" TEXT NOT NULL, \"last_node_id\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"profile_id\"));"
        }
      ]
    },
